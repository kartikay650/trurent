# Copy this file to .env.local and fill in real values. Never commit secrets.

# Anthropic — for the chat agent + listing AI auto-moderation
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — public URL + anon key are safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase — service role key bypasses RLS, SERVER-ONLY (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Standalone admin login (lib/adminAuth.js). Regenerate with:
#   node scripts/gen-admin-credentials.mjs
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=<salt-hex>:<scrypt-hash-hex>
ADMIN_SESSION_SECRET=<48-byte-base64url-random>

# Optional — for scripts/apply-migration.mjs to run DDL via the pooler.
# Find this in Supabase dashboard -> Project Settings -> Database.
# SUPABASE_DB_PASSWORD=

# Optional — Facebook scraping (currently stubbed; needs Playwright).
# FB_SESSION_COOKIE=
# FB_GROUP_IDS=
